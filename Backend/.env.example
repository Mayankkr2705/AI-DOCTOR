# Server Configuration
PORT=5000

# Database Configuration
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/medical-ai-chatbot
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medical-ai-chatbot

# JWT Secret (Change this to a strong random string in production!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production_12345

# Google Gemini AI API Key (REQUIRED)
# Get your free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# News API Key (OPTIONAL - mock data will be used if not provided)
# Get your free API key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual keys
# 3. NEVER commit the .env file to version control
